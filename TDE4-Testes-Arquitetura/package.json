{
  "name": "nexora-tde4-testes-arquitetura",
  "version": "1.0.0",
  "private": true,
  "description": "TDE 4 - Testes de arquitetura (backend e frontend) com dependency-cruiser",
  "scripts": {
    "test:backend": "depcruise --config backend/.dependency-cruiser.cjs ../os-service/src ../tecnicos-service/src",
    "test:frontend": "depcruise --config frontend/.dependency-cruiser.cjs ../host/src ../remote/src ../host-dashboard/src ../remote-dashboard/src",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.4.3",
    "typescript": "^5.9.3"
  }
}
