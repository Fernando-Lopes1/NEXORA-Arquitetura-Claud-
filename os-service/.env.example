PORT=8081

# ============================================================================
# 1. BANCO DE DADOS PRINCIPAL — Azure SQL Database (Free 1 DTU)
# Exemplo: Server=tcp:seu-servidor.database.windows.net,1433;Initial Catalog=nexora_os;Persist Security Info=False;User ID=seu_usuario;Password=sua_senha;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
# Se vazio, o microserviço ativa automaticamente o fallback local (SQLite / In-Memory)
# ============================================================================
AZURE_SQL_CONNECTION_STRING=

# ============================================================================
# 2. MESSAGE BROKER — Azure Service Bus (Fila: nexora-ordens-eventos)
# Exemplo: Endpoint=sb://seu-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=sua_chave
# ============================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=nexora-ordens-eventos

# URL do tecnicos-service para Bridge de Eventos
TECNICOS_SERVICE_URL=http://localhost:8082
